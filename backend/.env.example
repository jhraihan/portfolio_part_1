# Copy to .env and fill in real values. Never commit .env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
# Resolved in this order: USE_SQLITE, then DATABASE_URL, then the DB_* values.

# True runs on SQLite, so the project works before Postgres is set up.
USE_SQLITE=True

# Production: managed hosts (Railway, Neon, Supabase, Render, Fly) give you a
# single connection string. Set this and the DB_* values below are ignored.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local Postgres, used when USE_SQLITE=False and DATABASE_URL is unset.
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Production only
SECURE_SSL_REDIRECT=True

# Optional: contact form email notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_NOTIFY_EMAIL=
